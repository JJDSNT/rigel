build/
build-*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
Testing/
compile_commands.json

# Build outputs
*.a
*.o
*.so
*.so.*
*.dll
