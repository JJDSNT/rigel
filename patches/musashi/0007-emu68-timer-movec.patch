+			/*
+			 * Rigel: Emu68 invents control registers to hand the host's
+			 * timer to the guest, and its bare-metal examples read them
+			 * to time themselves — a frequency once at startup, then a
+			 * counter around each measured section.
+			 *
+			 * Two numberings are in the wild: 0x0E0/0x0E1 in the sources
+			 * shipped with Emu68, and 0x0C00/0x0C01 in binaries built
+			 * against a later one. Both are answered.
+			 *
+			 * The values are emulated CPU time, not the wall clock, so a
+			 * benchmark measures the machine being emulated and gives
+			 * the same answer every run.
+			 */
+			case 0x0e0:			   /* Emu68 timer frequency */
+			case 0xc00:
+				REG_DA[(word2 >> 12) & 15] =
+					(uint)rigel_m68k_timer_freq();
+				return;
+			case 0x0e1:			   /* Emu68 timer counter */
+			case 0xc01:
+				REG_DA[(word2 >> 12) & 15] =
+					(uint)rigel_m68k_timer_ticks();
+				return;
