{
  "_about": [
    "Cross-emulator timing reference for Copperline's timing-test ADF.",
    "",
    "The test takes over the machine, disables interrupts and DMA, and times a",
    "battery of operations with CIA-A timer A — the E-clock, CPU clock / 10.",
    "That is the only clock involved, so any emulator modelling the CPU-cycle to",
    "E-clock ratio correctly reports the same numbers. A row that disagrees says",
    "exactly which operation is timed differently.",
    "",
    "Results are drawn on screen and streamed out the serial port, which is how",
    "the harness reads them.",
    "",
    "The reference column is FS-UAE, as recorded in Copperline's own compare.py.",
    "Measurements, not our work: see external/copperline/timing-test/.",
    "",
    "Rows 19, 20 and 22 are raw VHPOSR values (vpos<<8 | hpos/2), not tick",
    "counts, so a ratio against them means nothing."
  ],

  "config": {
    "machine": "A500+ (ECS), 68EC020 @ 7.09 MHz, 2M chip + 512K slow, PAL",
    "kickstart": "2.05",
    "harness_args": "--cpu 68ec020 --chip 2048 --slow 512 --ecs"
  },

  "raw_rows": [19, 20, 22],

